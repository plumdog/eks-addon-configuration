{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "properties": {
    "credentialsSecretSync": {
      "additionalProperties": false,
      "properties": {
        "apiKeySecretId": {
          "maxLength": 2048,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "appKeySecretId": {
          "maxLength": 2048,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "kubernetesSecretName": {
          "default": "datadog-secret",
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "datadog-operator": {
      "properties": {
        "affinity": {
          "type": "object"
        },
        "apiKeyExistingSecret": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "appKeyExistingSecret": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "collectOperatorMetrics": {
          "type": "boolean"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "createControllerRevisions": {
          "type": "boolean"
        },
        "datadogAgentProfile": {
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "datadogCRDs": {
          "properties": {
            "crds": {
              "properties": {
                "datadogAgentProfiles": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "dd_url": {
          "type": "null"
        },
        "env": {
          "items": {},
          "type": "array"
        },
        "fullnameOverride": {
          "type": "string"
        },
        "image": {
          "properties": {
            "tag": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "installCRDs": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string"
        },
        "maximumGoroutines": {
          "type": "integer"
        },
        "metricsPort": {
          "type": "integer"
        },
        "nameOverride": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "rbac": {
          "properties": {
            "create": {
              "type": "boolean"
            }
          },
          "required": [
            "create"
          ],
          "type": "object"
        },
        "remoteConfiguration": {
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "remoteUpdates": {
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "replicaCount": {
          "type": "integer"
        },
        "resources": {
          "type": "object"
        },
        "secretBackend": {
          "properties": {
            "arguments": {
              "type": "string"
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "arguments"
          ],
          "type": "object"
        },
        "serviceAccount": {
          "properties": {
            "annotations": {
              "type": "object"
            },
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "create",
            "annotations"
          ],
          "type": "object"
        },
        "site": {
          "type": "null"
        },
        "tolerations": {
          "items": {},
          "type": "array"
        },
        "watchNamespaces": {
          "items": {},
          "type": "array"
        }
      },
      "type": "object"
    },
    "managedAgentInstallation": {
      "additionalProperties": false,
      "properties": {
        "acknowledgedOperationID": {
          "pattern": "^$|^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "bootstrap": {
          "additionalProperties": false,
          "properties": {
            "clusterName": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "site": {
              "enum": [
                "datadoghq.com",
                "datadoghq.eu",
                "us3.datadoghq.com",
                "us5.datadoghq.com",
                "ddog-gov.com",
                "ap1.datadoghq.com",
                "ap2.datadoghq.com"
              ],
              "type": "string"
            }
          },
          "required": [
            "clusterName",
            "site"
          ],
          "type": "object"
        },
        "desiredState": {
          "enum": [
            "installed",
            "absent"
          ],
          "type": "string"
        },
        "eksARNSHA256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "installationID": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "operationID": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "version": {
          "enum": [
            "v1"
          ],
          "type": "string"
        }
      },
      "required": [
        "version",
        "installationID",
        "eksARNSHA256",
        "operationID",
        "desiredState",
        "bootstrap"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "type": "object"
}
