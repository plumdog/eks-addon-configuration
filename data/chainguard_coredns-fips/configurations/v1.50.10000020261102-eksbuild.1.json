{
  "$defs": {
    "affinity": {
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {
          "$ref": "#/$defs/nodeAffinity",
          "description": "Node affinity"
        },
        "podAffinity": {
          "$ref": "#/$defs/podAffinity",
          "description": "Pod affinity"
        },
        "podAntiAffinity": {
          "$ref": "#/$defs/podAffinity",
          "description": "Pod anti-affinity"
        }
      },
      "type": "object"
    },
    "annotationKey": {
      "maxLength": 317,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])(?!(container\\.apparmor\\.security\\.beta|seccomp\\.security\\.alpha|container\\.seccomp\\.security\\.alpha)\\.kubernetes\\.io/)((?=[^/]{1,253}/)[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
      "type": "string"
    },
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/multiLineText"
      },
      "propertyNames": {
        "$ref": "#/$defs/annotationKey"
      },
      "type": "object"
    },
    "braceFreeText": {
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])",
      "type": "string"
    },
    "braceFreeTextList": {
      "items": {
        "$ref": "#/$defs/braceFreeText"
      },
      "type": "array"
    },
    "cpuMemoryResources": {
      "additionalProperties": false,
      "properties": {
        "limits": {
          "additionalProperties": false,
          "description": "Resource limits",
          "properties": {
            "cpu": {
              "allOf": [
                {
                  "$ref": "#/$defs/quantity"
                }
              ],
              "description": "CPU limit, such as 500m",
              "type": "string"
            },
            "memory": {
              "allOf": [
                {
                  "$ref": "#/$defs/quantity"
                }
              ],
              "description": "Memory limit, such as 256Mi",
              "type": "string"
            }
          },
          "type": "object"
        },
        "requests": {
          "additionalProperties": false,
          "description": "Resource requests",
          "properties": {
            "cpu": {
              "allOf": [
                {
                  "$ref": "#/$defs/quantity"
                }
              ],
              "description": "CPU request, such as 100m",
              "type": "string"
            },
            "memory": {
              "allOf": [
                {
                  "$ref": "#/$defs/quantity"
                }
              ],
              "description": "Memory request, such as 128Mi",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "dns1123Label": {
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "dns1123Subdomain": {
      "maxLength": 253,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
      "type": "string"
    },
    "intOrPercent": {
      "minimum": 0,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])(100|[1-9]?[0-9])%$",
      "type": [
        "integer",
        "string"
      ]
    },
    "labelKey": {
      "maxLength": 317,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])((?=[^/]{1,253}/)[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
      "type": "string"
    },
    "labelKeyList": {
      "items": {
        "$ref": "#/$defs/labelKey"
      },
      "type": "array"
    },
    "labelSelector": {
      "additionalProperties": false,
      "properties": {
        "matchExpressions": {
          "description": "Label requirements, all of which must match",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "$ref": "#/$defs/labelKey",
                "description": "Label key"
              },
              "operator": {
                "description": "In, NotIn, Exists, or DoesNotExist",
                "enum": [
                  "In",
                  "NotIn",
                  "Exists",
                  "DoesNotExist"
                ]
              },
              "values": {
                "$ref": "#/$defs/labelValueList",
                "description": "Label values for In and NotIn"
              }
            },
            "required": [
              "key",
              "operator"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "matchLabels": {
          "$ref": "#/$defs/labels",
          "description": "Labels that an object must carry, all of them"
        }
      },
      "type": "object"
    },
    "labelValue": {
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$",
      "type": "string"
    },
    "labelValueList": {
      "items": {
        "$ref": "#/$defs/labelValue"
      },
      "type": "array"
    },
    "labels": {
      "additionalProperties": {
        "$ref": "#/$defs/labelValue"
      },
      "propertyNames": {
        "$ref": "#/$defs/labelKey"
      },
      "type": "object"
    },
    "multiLineText": {
      "pattern": "^(?![\\s\\S]*[\\x00-\\x08\\x0b-\\x1f\\x7f-\\x9f\\u2028\\u2029])",
      "type": "string"
    },
    "nodeAffinity": {
      "additionalProperties": false,
      "properties": {
        "preferredDuringSchedulingIgnoredDuringExecution": {
          "description": "Weighted node preferences",
          "items": {
            "additionalProperties": false,
            "properties": {
              "preference": {
                "$ref": "#/$defs/nodeSelectorTerm",
                "description": "Node selector term; all of its requirements must match"
              },
              "weight": {
                "description": "Weight from 1 to 100",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "weight"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "additionalProperties": false,
          "description": "Nodes the pod must run on",
          "properties": {
            "nodeSelectorTerms": {
              "description": "Terms, any one of which must match",
              "items": {
                "$ref": "#/$defs/requiredNodeSelectorTerm"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "nodeSelectorRequirement": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/labelKey",
          "description": "Node label key"
        },
        "operator": {
          "description": "In, NotIn, Exists, DoesNotExist, Gt, or Lt",
          "enum": [
            "In",
            "NotIn",
            "Exists",
            "DoesNotExist",
            "Gt",
            "Lt"
          ]
        },
        "values": {
          "$ref": "#/$defs/braceFreeTextList",
          "description": "Values to compare with"
        }
      },
      "required": [
        "key",
        "operator"
      ],
      "type": "object"
    },
    "nodeSelectorTerm": {
      "additionalProperties": false,
      "properties": {
        "matchExpressions": {
          "description": "Requirements on node labels",
          "items": {
            "$ref": "#/$defs/nodeSelectorRequirement"
          },
          "type": "array"
        },
        "matchFields": {
          "description": "Requirements on node fields",
          "items": {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "Node field; only metadata.name",
                "enum": [
                  "metadata.name"
                ]
              },
              "operator": {
                "description": "In or NotIn",
                "enum": [
                  "In",
                  "NotIn"
                ]
              },
              "values": {
                "description": "The one node name to compare with",
                "items": {
                  "$ref": "#/$defs/dns1123Subdomain"
                },
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "key",
              "operator",
              "values"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "podAffinity": {
      "additionalProperties": false,
      "properties": {
        "preferredDuringSchedulingIgnoredDuringExecution": {
          "description": "Weighted terms the scheduler tries to satisfy",
          "items": {
            "additionalProperties": false,
            "properties": {
              "podAffinityTerm": {
                "$ref": "#/$defs/podAffinityTerm",
                "description": "Pod affinity term"
              },
              "weight": {
                "description": "Weight from 1 to 100",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "weight",
              "podAffinityTerm"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "requiredDuringSchedulingIgnoredDuringExecution": {
          "description": "Terms that must all hold for the pod to be scheduled on a node",
          "items": {
            "$ref": "#/$defs/podAffinityTerm"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "podAffinityTerm": {
      "additionalProperties": false,
      "properties": {
        "labelSelector": {
          "$ref": "#/$defs/labelSelector",
          "description": "Pods that the term matches"
        },
        "namespaceSelector": {
          "$ref": "#/$defs/labelSelector",
          "description": "Namespaces whose pods the term matches, by label"
        },
        "namespaces": {
          "description": "Namespaces whose pods the term matches",
          "items": {
            "$ref": "#/$defs/dns1123Label"
          },
          "type": "array"
        },
        "topologyKey": {
          "$ref": "#/$defs/labelKey",
          "description": "Node label whose value defines the topology domain"
        }
      },
      "required": [
        "topologyKey"
      ],
      "type": "object"
    },
    "quantity": {
      "minimum": 0,
      "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])\\+?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([KMGTPE]i|[numkMGTPE]|[eE][+-]?[0-9]+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "requiredNodeSelectorTerm": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeSelectorTerm"
        }
      ],
      "properties": {
        "matchExpressions": {
          "description": "Requirements on node labels",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/nodeSelectorRequirement"
              }
            ],
            "properties": {
              "values": {
                "$ref": "#/$defs/labelValueList",
                "description": "Label values to compare with"
              }
            }
          },
          "type": "array"
        }
      }
    },
    "tolerations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "effect": {
            "description": "Taint effect to match: NoSchedule, PreferNoSchedule, or NoExecute; empty matches all",
            "enum": [
              "",
              "NoSchedule",
              "PreferNoSchedule",
              "NoExecute"
            ]
          },
          "key": {
            "anyOf": [
              {
                "$ref": "#/$defs/labelKey"
              },
              {
                "const": ""
              }
            ],
            "description": "Taint key that the toleration applies to; empty with Exists matches every key"
          },
          "operator": {
            "description": "Exists or Equal; empty means Equal",
            "enum": [
              "",
              "Equal",
              "Exists"
            ]
          },
          "tolerationSeconds": {
            "description": "Seconds the pod stays bound after a NoExecute taint appears",
            "type": "integer"
          },
          "value": {
            "$ref": "#/$defs/labelValue",
            "description": "Taint value to match with Equal"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "topologySpreadConstraints": {
      "items": {
        "additionalProperties": false,
        "dependentRequired": {
          "matchLabelKeys": [
            "labelSelector"
          ]
        },
        "properties": {
          "labelSelector": {
            "$ref": "#/$defs/labelSelector",
            "description": "Pods to count"
          },
          "matchLabelKeys": {
            "$ref": "#/$defs/labelKeyList",
            "description": "Pod label keys whose values also select the pods to count"
          },
          "maxSkew": {
            "description": "Largest allowed difference in pod count between topology domains",
            "minimum": 1,
            "type": "integer"
          },
          "minDomains": {
            "description": "Minimum number of eligible domains",
            "minimum": 1,
            "type": "integer"
          },
          "nodeAffinityPolicy": {
            "description": "Honor or Ignore: whether node affinity limits the domains",
            "enum": [
              "Honor",
              "Ignore"
            ]
          },
          "nodeTaintsPolicy": {
            "description": "Honor or Ignore: whether node taints limit the domains",
            "enum": [
              "Honor",
              "Ignore"
            ]
          },
          "topologyKey": {
            "description": "Node label whose value defines the topology domain",
            "minLength": 1,
            "pattern": "^(?![\\s\\S]*[\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029{}])",
            "type": "string"
          },
          "whenUnsatisfiable": {
            "description": "DoNotSchedule or ScheduleAnyway",
            "enum": [
              "DoNotSchedule",
              "ScheduleAnyway"
            ]
          }
        },
        "required": [
          "maxSkew",
          "topologyKey",
          "whenUnsatisfiable"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "additionalProperties": false,
  "description": "Configuration values for the Chainguard CoreDNS EKS add-on. They follow AWS's own CoreDNS add-on, plus settings to take over the objects that add-on created. Defaults are this chart's, which differ from AWS's in places; see the chart README.",
  "examples": [
    {
      "affinity": {
        "nodeAffinity": {
          "requiredDuringSchedulingIgnoredDuringExecution": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/os",
                    "operator": "In",
                    "values": [
                      "linux"
                    ]
                  },
                  {
                    "key": "kubernetes.io/arch",
                    "operator": "In",
                    "values": [
                      "amd64",
                      "arm64"
                    ]
                  }
                ]
              }
            ]
          }
        },
        "podAntiAffinity": {
          "preferredDuringSchedulingIgnoredDuringExecution": [
            {
              "podAffinityTerm": {
                "labelSelector": {
                  "matchExpressions": [
                    {
                      "key": "app.kubernetes.io/name",
                      "operator": "In",
                      "values": [
                        "coredns"
                      ]
                    }
                  ]
                },
                "topologyKey": "kubernetes.io/hostname"
              },
              "weight": 100
            }
          ]
        }
      },
      "podDisruptionBudget": {
        "enabled": true,
        "maxUnavailable": 1
      },
      "replicaCount": 2,
      "tolerations": [
        {
          "key": "CriticalAddonsOnly",
          "operator": "Exists"
        },
        {
          "effect": "NoSchedule",
          "key": "node-role.kubernetes.io/control-plane"
        }
      ]
    },
    {
      "deployment": {
        "selector": {
          "matchLabels": {
            "eks.amazonaws.com/component": "coredns",
            "k8s-app": "kube-dns"
          }
        }
      },
      "k8sAppLabelOverride": "kube-dns",
      "podLabels": {
        "eks.amazonaws.com/component": "coredns"
      },
      "service": {
        "selector": {
          "k8s-app": "kube-dns"
        }
      }
    }
  ],
  "properties": {
    "affinity": {
      "anyOf": [
        {
          "$ref": "#/$defs/affinity"
        },
        {
          "type": "null"
        }
      ],
      "default": {},
      "description": "Affinity rules for the CoreDNS pods, in the Kubernetes Affinity shape. The chart sets none by default; AWS's own add-on requires Linux nodes on amd64 or arm64 and prefers one CoreDNS pod per node. Values may not contain { or }, because the chart renders this setting as a Helm template.",
      "examples": [
        {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/os",
                      "operator": "In",
                      "values": [
                        "linux"
                      ]
                    },
                    {
                      "key": "kubernetes.io/arch",
                      "operator": "In",
                      "values": [
                        "amd64",
                        "arm64"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "podAntiAffinity": {
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "podAffinityTerm": {
                  "labelSelector": {
                    "matchExpressions": [
                      {
                        "key": "app.kubernetes.io/name",
                        "operator": "In",
                        "values": [
                          "coredns"
                        ]
                      }
                    ]
                  },
                  "topologyKey": "kubernetes.io/hostname"
                },
                "weight": 100
              }
            ]
          }
        }
      ]
    },
    "annotationTopologyMode": {
      "description": "Topology Aware Routing for the kube-dns Service, and for the metrics Service when prometheus.service.enabled is set. Sets the service.kubernetes.io/topology-mode annotation to Auto or Disabled. Unset leaves the annotations alone.",
      "enum": [
        "Disabled",
        "Auto"
      ],
      "examples": [
        "Auto"
      ],
      "type": "string"
    },
    "autoScaling": {
      "additionalProperties": false,
      "description": "Autoscaling of the CoreDNS replicas, in the shape of AWS's own add-on. This chart runs the cluster-proportional-autoscaler instead of EKS's own controller: replicas follow the larger of nodes divided by nodesPerReplica and CPU cores divided by cpuCoresPerReplica, without EKS's 10-minute peak window or its gradual scale-down.",
      "examples": [
        {
          "enabled": true
        },
        {
          "cpuCoresPerReplica": 256,
          "enabled": true,
          "maxReplicas": 10,
          "minReplicas": 2,
          "nodesPerReplica": 16
        }
      ],
      "properties": {
        "cpuCoresPerReplica": {
          "description": "Cluster CPU cores per CoreDNS replica. Unset uses 256, as AWS's own add-on does.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "enabled": {
          "description": "Run the cluster-proportional-autoscaler for CoreDNS. Overrides autoscaler.enabled.",
          "type": "boolean"
        },
        "maxReplicas": {
          "description": "Most replicas the autoscaler runs. Unset means no maximum.",
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        "minReplicas": {
          "description": "Fewest replicas the autoscaler keeps. Unset, the autoscaler keeps 2 replicas on clusters with more than one node and 1 on a single node.",
          "maximum": 1000,
          "minimum": 2,
          "type": "integer"
        },
        "nodesPerReplica": {
          "description": "Cluster nodes per CoreDNS replica. Unset uses 16, as AWS's own add-on does.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    },
    "corefile": {
      "$ref": "#/$defs/multiLineText",
      "default": "",
      "description": "Entire Corefile contents. When set, replaces the Corefile that the chart builds. Keep the health plugin on :8080 and the ready plugin on :8181, which the liveness and readiness probes call, and serve DNS on :53, which the Service targets. May contain tabs and line feeds, but no other control characters.",
      "examples": [
        ".:53 {\n    errors\n    health {\n        lameduck 5s\n    }\n    ready\n    kubernetes cluster.local in-addr.arpa ip6.arpa {\n        pods insecure\n        fallthrough in-addr.arpa ip6.arpa\n    }\n    prometheus :9153\n    forward . /etc/resolv.conf\n    cache 30\n    loop\n    reload\n    loadbalance\n}\n"
      ]
    },
    "deployment": {
      "additionalProperties": false,
      "description": "Settings for the CoreDNS Deployment.",
      "properties": {
        "selector": {
          "$ref": "#/$defs/labelSelector",
          "default": {},
          "description": "Label selector of the CoreDNS Deployment, which Kubernetes does not let change after creation. Unset uses the chart's own labels. To take over the Deployment that AWS's own add-on created, set matchLabels to k8s-app: kube-dns and eks.amazonaws.com/component: coredns, with k8sAppLabelOverride kube-dns and podLabels eks.amazonaws.com/component: coredns, and keep all three set on every later update."
        }
      },
      "type": "object"
    },
    "k8sAppLabelOverride": {
      "description": "Value of the k8s-app label on the chart's objects and CoreDNS pods, which is coredns when unset. kube-dns, with podLabels and deployment.selector, takes over the objects that AWS's own add-on created; see the chart README.",
      "enum": [
        "kube-dns"
      ],
      "examples": [
        "kube-dns"
      ],
      "type": "string"
    },
    "nodeSelector": {
      "$ref": "#/$defs/labels",
      "default": {},
      "description": "Node labels a node must have to run the CoreDNS pods.",
      "examples": [
        {
          "kubernetes.io/os": "linux"
        }
      ]
    },
    "podAnnotations": {
      "$ref": "#/$defs/annotations",
      "default": {},
      "description": "Annotations to add to the CoreDNS pods. AppArmor and seccomp annotation keys are not allowed.",
      "examples": [
        {
          "cluster-autoscaler.kubernetes.io/safe-to-evict": "false"
        }
      ]
    },
    "podDisruptionBudget": {
      "additionalProperties": false,
      "description": "PodDisruptionBudget for the CoreDNS pods. The chart creates none by default; AWS's own add-on creates one with maxUnavailable 1.",
      "examples": [
        {
          "enabled": true,
          "maxUnavailable": 1
        }
      ],
      "not": {
        "required": [
          "maxUnavailable",
          "minAvailable"
        ]
      },
      "properties": {
        "enabled": {
          "description": "Create the PodDisruptionBudget. true with neither minAvailable nor maxUnavailable uses maxUnavailable 1, as AWS's own add-on does; false creates none.",
          "examples": [
            true,
            false
          ],
          "type": "boolean"
        },
        "maxUnavailable": {
          "$ref": "#/$defs/intOrPercent",
          "description": "Most CoreDNS pods that may be unavailable during a voluntary disruption, as a number or a percentage such as 25%."
        },
        "minAvailable": {
          "$ref": "#/$defs/intOrPercent",
          "description": "Fewest CoreDNS pods that must stay available during a voluntary disruption, as a number or a percentage. Set this or maxUnavailable, not both."
        }
      },
      "type": "object"
    },
    "podLabels": {
      "allOf": [
        {
          "$ref": "#/$defs/labels"
        },
        {
          "propertyNames": {
            "allOf": [
              {
